---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { Content } from '../my-site/bio.md';
import photo from '../my-site/home/audrey.webp';
---
<Base title="Biography">
  <h1>Biography</h1>
  <Image src={photo} alt="Audrey O'Neil at the pottery wheel" class="me" widths={[480, 900]} sizes="(max-width: 700px) 100vw, 42rem" />
  <div class="bio"><Content /></div>
  <p><a class="button" href="/audrey-oneil-cv.pdf" target="_blank" rel="noopener">View my CV (PDF)</a></p>

</Base>

<style>
  .bio { max-width: 42rem; font-size: 1.1rem; }
  .me { width: 100%; max-width: 42rem; border-radius: 4px; margin: 1rem 0 2rem; }
</style>
