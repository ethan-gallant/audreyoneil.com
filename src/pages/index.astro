---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import logo from '../assets/logo.svg';
import { site } from '../site.js';
import { homeImages } from '../images.js';
---
<Base>
  <section class="intro">
    <img src={logo.src} alt={`${site.name} Art`} class="logo" width="560" />
    <a class="button" href={site.instagram} target="_blank" rel="noopener">Follow on Instagram {site.instagramHandle}</a>
  </section>

  <section class="slideshow" aria-label="Recent work">
    {homeImages.length
      ? homeImages.map((img, i) => (
          <Image src={img.src} alt={img.caption || "Artwork by Audrey O'Neil"} widths={[480, 900, 1400]} sizes="(max-width: 700px) 100vw, 600px" class={i === 0 ? 'shown' : ''} loading={i === 0 ? 'eager' : 'lazy'} />
        ))
      : <p class="empty">Pictures coming soon.</p>}
    {homeImages.length > 1 && <>
      <button class="arrow prev" aria-label="Previous picture">‹</button>
      <button class="arrow next" aria-label="Next picture">›</button>
    </>}
  </section>
</Base>

<style>
  .intro { display: flex; flex-direction: column; align-items: center; gap: 2rem; text-align: center; margin-bottom: 3rem; }
  .logo { width: min(560px, 90%); }
  /* One picture at a time, fading to the next every 30 seconds */
  .slideshow { position: relative; width: min(100%, 600px, calc(80vh * 3 / 4)); aspect-ratio: 3 / 4; margin: 0 auto; }
  .slideshow :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 4px; opacity: 0; transition: opacity 1.5s ease; }
  .slideshow :global(img.shown) { opacity: 1; }
  .arrow {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 1;
    width: 3rem; height: 3rem; border-radius: 50%; border: 1px solid var(--accent);
    background: rgba(34, 34, 34, .6); color: var(--accent); font-size: 2rem; line-height: 1;
    display: grid; place-items: center; padding: 0 0 .25rem; cursor: pointer;
    opacity: 0; transition: opacity .3s;
  }
  .arrow:hover, .arrow:focus-visible { opacity: 1; background: var(--accent); color: var(--background); }
  /* Phones and tablets can't hover, so keep the arrows faintly visible there */
  @media (hover: none) { .arrow { opacity: .7; } }
  .prev { left: .75rem; }
  .next { right: .75rem; }
</style>

<script>
  const SECONDS_PER_PICTURE = 30;
  const slides = document.querySelectorAll('.slideshow img');
  let current = 0;
  let timer;

  function show(n) {
    slides[current].classList.remove('shown');
    current = (n + slides.length) % slides.length;
    slides[current].classList.add('shown');
    clearInterval(timer);
    timer = setInterval(() => show(current + 1), SECONDS_PER_PICTURE * 1000);
  }

  if (slides.length > 1) {
    document.querySelector('.slideshow .prev').addEventListener('click', () => show(current - 1));
    document.querySelector('.slideshow .next').addEventListener('click', () => show(current + 1));
    show(0);
  }
</script>
