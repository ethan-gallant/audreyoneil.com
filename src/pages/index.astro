---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import logo from '../assets/logo.svg';
import { site } from '../site.js';
import { homeImages } from '../images.js';
---
<Base>
  <section class="intro">
    <img src={logo.src} alt={`${site.name} Art`} class="logo" width="560" />
    <a class="button" href={site.instagram} target="_blank" rel="noopener">Follow on Instagram {site.instagramHandle}</a>
  </section>

  <section class="home-images">
    {homeImages.length
      ? homeImages.map((img) => <Image src={img.src} alt={img.caption} widths={[480, 900, 1400]} sizes="(max-width: 700px) 100vw, 50vw" />)
      : <p class="empty">Pictures coming soon.</p>}
  </section>
</Base>

<style>
  .intro { display: flex; flex-direction: column; align-items: center; gap: 2rem; text-align: center; margin-bottom: 3rem; }
  .logo { width: min(560px, 90%); }
  .home-images { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 1.25rem; }
  .home-images img { width: 100%; max-height: 80vh; object-fit: cover; border-radius: 4px; }
</style>
